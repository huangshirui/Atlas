{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AISR Atlas V0.1 Workspace",
  "description": "Top-level isolation and lifecycle metadata for one Atlas Workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "root_unit_id",
    "current_published_revision_id",
    "active_draft_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "root_unit_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "current_published_revision_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_draft_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
