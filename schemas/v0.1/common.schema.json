{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AISR Atlas V0.1 Common Definitions",
  "description": "Shared structural definitions for AISR Atlas V0.1 domain schemas.",
  "type": "object",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "typeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "ai",
            "automation",
            "system"
          ]
        },
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "web",
            "mcp",
            "api",
            "adapter",
            "automation",
            "system",
            "import",
            "other"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "customTypeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/typeId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "issue",
            "pull-request",
            "branch",
            "incident",
            "work-session",
            "release",
            "document",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  }
}
