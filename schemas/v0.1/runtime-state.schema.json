{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AISR Atlas V0.1 Runtime State",
  "description": "Current observed runtime state for one Unit. Updating it does not create a Definition Revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "unit_id",
    "observed_at",
    "status",
    "source",
    "facets"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "unit_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "observed_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "status": {
      "type": "string",
      "enum": [
        "unknown",
        "not-deployed",
        "deploying",
        "running",
        "degraded",
        "down",
        "maintenance"
      ]
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "facets": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "facet.schema.json"
          },
          {
            "type": "object",
            "properties": {
              "state_class": {
                "const": "runtime"
              }
            }
          }
        ]
      }
    }
  }
}
