{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AISR Atlas V0.1 Facet",
  "description": "An extensible dimension attached to a Unit. state_class controls whether it belongs to Definition, Runtime State, or Work State.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "unit_id",
    "type",
    "state_class",
    "data"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "unit_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "architecture",
            "development",
            "runtime",
            "health",
            "deployment",
            "work"
          ]
        },
        {
          "$ref": "common.schema.json#/$defs/typeId"
        }
      ]
    },
    "state_class": {
      "type": "string",
      "enum": [
        "definition",
        "runtime",
        "work"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
