{
  "name": "aisr-atlas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @aisr-atlas/web run dev",
    "build": "npm --workspace @aisr-atlas/web run build",
    "test:domain": "node scripts/validate-domain.mjs",
    "check": "npm run test:domain && npm run build"
  }
}
